import discord
from discord.ext import commands
import requests
import re
import time
from dotenv import load_dotenv
import os

# Tải biến môi trường từ file .env
load_dotenv()
API_URL = os.getenv("API_URL")

# Kiểm tra nếu API_URL không được tìm thấy
if not API_URL:
    raise ValueError("API_URL không được tìm thấy trong file .env. Vui lòng kiểm tra lại.")

# Cấu hình bot với intent
intents = discord.Intents.default()
intents.message_content = True  # Bật để đọc nội dung tin nhắn
intents.dm_messages = True      # Bật để gửi/nhận DM
bot = commands.Bot(command_prefix="/", intents=intents)

# Sự kiện khi bot sẵn sàng
@bot.event
async def on_ready():
    print(f"Bot đã sẵn sàng với tên: {bot.user}")

# Sự kiện khi nhận tin nhắn
@bot.event
async def on_message(message):
    # Ngăn bot phản hồi chính nó
    if message.author == bot.user:
        return

    # Kiểm tra xem tin nhắn có chứa liên kết Linkvertise không
    link_pattern = r"https?://(?:www\.)?linkvertise\.com/\d+/[a-zA-Z0-9-]+"
    link_match = re.search(link_pattern, message.content)
    if link_match:
        link = link_match.group(0)
        print(f"[1] Phát hiện liên kết: {link}")

        # Tạo embed ban đầu cho tiến trình
        embed = discord.Embed(
            title="Bypass Linkvertise - Tiến trình",
            description=f"Đang xử lý liên kết: `{link}`",
            color=discord.Color.orange()
        )
        embed.set_footer(text="Bot by Grok | Processing...")
        dm_channel = await message.author.create_dm()  # Mở DM với người gửi
        initial_message = await dm_channel.send(embed=embed)

        try:
            # Bước 1: Gửi yêu cầu tới trang bypass (URL ẩn)
            print(f"[2] Gửi yêu cầu tới API...")
            embed.description = "Bước 2: Gửi yêu cầu tới API..."
            await initial_message.edit(embed=embed)
            payload = {"link": link}
            response = requests.get(API_URL, params=payload, timeout=10)
            
            # Hiển thị thông tin (ẩn URL yêu cầu)
            print(f"[3] Mã trạng thái: {response.status_code}")
            print("[4] Yêu cầu đã được gửi thành công")
            embed.description = f"Bước 3: Mã trạng thái: {response.status_code}\nBước 4: Yêu cầu đã được gửi thành công"
            await initial_message.edit(embed=embed)
            
            # Bước 2: Kiểm tra phản hồi
            print("[5] Phân tích phản hồi...")
            embed.description += "\nBước 5: Phân tích phản hồi..."
            await initial_message.edit(embed=embed)
            if response.status_code != 200:
                embed.description += "\n❌ Lỗi: Không thể truy cập API."
                embed.color = discord.Color.red()
                await initial_message.edit(embed=embed)
                return
            
            # Bước 3: Lấy liên kết đích
            try:
                print("[6] Lấy liên kết đích...")
                embed.description += "\nBước 6: Lấy liên kết đích..."
                await initial_message.edit(embed=embed)
                data = response.json()
                final_url = data.get("result")
                print(f"[7] Liên kết đích: {final_url or 'Không tìm thấy'}")
                embed.description += f"\nLiên kết đích: {final_url or 'Không tìm thấy'}"
            except ValueError:
                print("[7] Phản hồi không phải JSON. Kiểm tra thủ công...")
                embed.description += "\n❌ Phản hồi không phải JSON."
                final_url = None
            
            # Cập nhật embed với kết quả
            embed.title = "✅ Linkvertise Bypassed"
            embed.description = f"**Tiến trình hoàn tất**\n{embed.description}"
            embed.color = discord.Color.green()
            embed.set_footer(text=f"Bot by Grok | Wed, 11 Jun 2025 03:27 PM +07")
            await initial_message.edit(embed=embed)

        except Exception as e:
            print(f"[Lỗi] Đã xảy ra lỗi: {str(e)}")
            embed.description += f"\n❌ Lỗi: {str(e)}"
            embed.color = discord.Color.red()
            await initial_message.edit(embed=embed)

# Chạy bot
# Thay YOUR_BOT_TOKEN bằng token bot của bạn
bot.run("")
